# Count primes below 100000 using trial division
let count = 0
let n = 2

while n < 100000: {
  let is_prime = 1
  let d = 2
  while d * d <= n: {
    let rem = n - (n / d) * d
    if rem < 1: {
      let is_prime = 0
    }
    let d = d + 1
  }
  let count = count + is_prime
  let n = n + 1
}

print(count)
